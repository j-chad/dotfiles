#!/bin/sh
# Suggests a commit message from the staged diff using a local LM Studio
# server, and adds it as comments (never as editable text) for review.
# Only runs for `git ai-commit` (GIT_COMMIT_AI=1). Best-effort: any failure
# (server down, cold model, malformed output) falls through to a normal
# commit with no suggestion.
set -eu

[ "${GIT_COMMIT_AI:-}" = 1 ] || exit 0
command -v jq >/dev/null 2>&1 || { echo "ai-commit: jq not found; skipping suggestion" >&2; exit 0; }
command -v curl >/dev/null 2>&1 || { echo "ai-commit: curl not found; skipping suggestion" >&2; exit 0; }

msg_file=$1
commit_source=${2:-}

case "$commit_source" in
	""|template) ;;
	*) exit 0 ;;
esac

diff=$(git diff --cached)
[ -n "$diff" ] || exit 0

# Cap the total diff size (bytes, not per-line) so large changes don't blow
# the model's context window.
diff=$(printf '%s' "$diff" | head -c 8000)

repo=$(basename "$(git rev-parse --show-toplevel)")
branch=$(git symbolic-ref --short -q HEAD || echo "detached HEAD")
stat=$(git diff --cached --stat | tail -1)
files=$(git diff --cached --name-status)
recent_titles=$(git log -10 --format='- %s' 2>/dev/null || true)

context=$(cat <<EOF
Repository: $repo
Branch: $branch

Recent commit titles (for style reference):
$recent_titles

Staged changes:
$files

Summary: $stat

Staged diff:
$diff
EOF
)

base_url=$(git config ai.commitUrl || echo "http://localhost:1234/v1")
model=$(git config ai.commitModel || echo "")
timeout=$(git config ai.commitTimeout || echo 20)

schema='{
	"type": "object",
	"properties": {
		"title": {"type": "string", "minLength": 5, "maxLength": 72},
		"body": {"type": "array", "items": {"type": "string", "maxLength": 80}, "maxItems": 10}
	},
	"required": ["title", "body"],
	"additionalProperties": false
}'

payload=$(jq -n --arg model "$model" --arg context "$context" --argjson schema "$schema" '
	{
		temperature: 0.2,
		messages: [
			{role: "system", content: "You write git commit messages from a diff and repository context. Title: imperative mood, no trailing period, specific about what changed. Body: explain what changed and why, wrapped under 80 characters per line. Match the style of the recent commit titles when possible. Omit the body if the change is trivial."},
			{role: "user", content: $context}
		],
		response_format: {type: "json_schema", json_schema: {name: "commit_message", schema: $schema}}
	} + (if $model != "" then {model: $model} else {} end)
')

tmp_out=$(mktemp)
tmp_msg=$(mktemp)
cleanup() { rm -f "$tmp_out" "$tmp_msg"; }
trap cleanup EXIT INT TERM

start=$(date +%s)
curl -s --max-time "$timeout" \
	-H 'Content-Type: application/json' \
	-d "$payload" \
	"$base_url/chat/completions" > "$tmp_out" 2>/dev/null &
curl_pid=$!

if [ -t 2 ]; then
	spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
	i=0
	while kill -0 "$curl_pid" 2>/dev/null; do
		elapsed=$(($(date +%s) - start))
		i=$(((i + 1) % 10))
		frame=$(printf '%s' "$spin" | cut -c$((i + 1)))
		printf '\r%s Generating commit message (LM Studio)… %ss' "$frame" "$elapsed" >&2
		sleep 0.2
	done
	printf '\r\033[K' >&2
else
	echo "ai-commit: generating commit message via LM Studio…" >&2
fi

if ! wait "$curl_pid"; then
	elapsed=$(($(date +%s) - start))
	echo "ai-commit: LM Studio unavailable after ${elapsed}s; continuing without suggestion" >&2
	exit 0
fi
elapsed=$(($(date +%s) - start))

content=$(jq -r '.choices[0].message.content // empty' "$tmp_out" 2>/dev/null || true)
if [ -z "$content" ]; then
	echo "ai-commit: no response from LM Studio after ${elapsed}s; continuing without suggestion" >&2
	exit 0
fi

if ! printf '%s' "$content" \
	| jq -e '(.title | type == "string" and length >= 5 and length <= 72) and (.body | type == "array")' >/dev/null 2>&1; then
	echo "ai-commit: malformed response after ${elapsed}s; continuing without suggestion" >&2
	exit 0
fi

# Comment char is configurable; 'auto' resolves to a real char we cannot
# predict here, so fall back to '#'.
comment_char="$(git config core.commentChar 2>/dev/null || echo '#')"
if [ "$comment_char" = auto ]; then comment_char='#'; fi

title=$(printf '%s' "$content" | jq -r '.title')
body=$(printf '%s' "$content" | jq -r '.body[]?')

{
	echo ""
	echo "${comment_char} AI suggestion: $title"
	if [ -n "$body" ]; then
		echo "${comment_char}"
		printf '%s\n' "$body" | sed "s/^/${comment_char} /"
	fi
	echo "${comment_char}"
	echo "${comment_char} Remove the comment prefixes above to use this message."
	cat "$msg_file"
} > "$tmp_msg"
mv "$tmp_msg" "$msg_file"

echo "ai-commit: commit message generated in ${elapsed}s" >&2
