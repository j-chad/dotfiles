#!/bin/sh
# Runs the repository's executable hook before personal global actions.
set -eu

hook_name=$1
shift
hook_dir=$(CDPATH= cd -- "${0%/*}" && pwd -P)
common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
repo_hooks=$(git config --path hooks.repositoryPath || printf '%s/hooks' "$common_dir")
repo_hook="$repo_hooks/$hook_name"

# Reject cycles, including a repository hook symlinked to a global entrypoint.
case ":${GIT_HOOKS_ACTIVE:-}:" in
	*:"$hook_name":*) echo "git-hooks: recursive $hook_name delegation" >&2; exit 1 ;;
esac
export GIT_HOOKS_ACTIVE="${GIT_HOOKS_ACTIVE:-}:$hook_name"

stdin_file=
case "$hook_name" in
	pre-push|post-rewrite)
		if [ ! -t 0 ]; then
			stdin_file=$(mktemp)
			trap 'rm -f "$stdin_file"' 0
			trap 'exit 130' INT
			trap 'exit 143' TERM
			cat > "$stdin_file"
		fi
		;;
esac

run() {
	if [ -n "$stdin_file" ]; then
		"$@" < "$stdin_file"
	else
		"$@"
	fi
}

repo_status=0
if [ -x "$repo_hook" ]; then
	repo_hooks_dir=$(CDPATH= cd -- "$repo_hooks" && pwd -P)
	if [ "$repo_hooks_dir" != "$hook_dir" ] && ! [ "$repo_hook" -ef "$hook_dir/$hook_name" ]; then
		if [ "$hook_name" = post-commit ]; then
			run "$repo_hook" "$@" || repo_status=$?
		else
			run "$repo_hook" "$@"
		fi
	fi
fi

PATH="$HOME/.local/bin:$PATH"
export PATH
if ! command -v prek >/dev/null 2>&1; then
	if [ "$hook_name" = post-commit ]; then
		"$HOME/.config/prek/scripts/clear-message"
		exit "$repo_status"
	fi
	echo "git-hooks: prek is required; install it with https://prek.j178.dev/installation/" >&2
	exit 127
fi

if [ "$hook_name" = post-commit ] && [ "${repo_status:-0}" -ne 0 ]; then
	run prek hook-impl --config "$HOME/.config/prek/global.toml" --hook-type "$hook_name" -- "$@" || true
	exit "$repo_status"
fi
run prek hook-impl --config "$HOME/.config/prek/global.toml" --hook-type "$hook_name" -- "$@"
