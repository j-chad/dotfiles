#!/usr/bin/env bash
set -euo pipefail

# Delegate to a repo-local hook ONLY if it's a different file than this one
# (with core.hooksPath set, git-path hooks == this global dir, so guard against self)
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
repo_hook="$(git rev-parse --git-path hooks)/$(basename "$0")"
repo_hook="$(cd "$(dirname "$repo_hook")" 2>/dev/null && pwd)/$(basename "$repo_hook")"
if [ -x "$repo_hook" ] && [ "$repo_hook" != "$self" ]; then
  "$repo_hook" "$@"
fi

msg_file="$1"   # commit-msg receives the path to the message file

# Comment char is configurable; 'auto' resolves to a real char we can't easily
# predict here, so fall back to '#' (the overwhelmingly common case).
comment_char="$(git config core.commentChar 2>/dev/null || echo '#')"
if [ "$comment_char" = auto ]; then comment_char='#'; fi

# --- message cleanup (mirror git's default --cleanup=strip) ----------------
# Cut the verbose diff (scissors line down), drop comment lines, then trim
# leading/trailing blank lines so we lint the same bytes git will commit.
cleaned="$(
  sed "\|^${comment_char}.*>8|,\$d" "$msg_file" \
    | grep -v "^${comment_char}" \
    || true
)"
cleaned="$(printf '%s\n' "$cleaned" \
  | awk 'NF{f=1; last=NR} f{buf[NR]=$0} END{for(i=1;i<=last;i++) print buf[i]}')"

if [ -z "$cleaned" ]; then
  echo "commit-msg: aborting — empty commit message" >&2
  exit 1
fi

# Split into lines portably (no mapfile). title == line 1, body == line 2..N.
L=()
while IFS= read -r _line || [ -n "$_line" ]; do L+=("$_line"); done <<< "$cleaned"
title="${L[0]:-}"
body=("${L[@]:1}")

# Skip auto-generated messages: merges, reverts, and autosquash commits have
# intentionally-shaped subjects that these rules would wrongly reject.
case "$title" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

# --- violation accumulator -------------------------------------------------
violations=()
v() { violations+=("$1"); }

# --- Title Rules ---
title_max=72
title_min=5

# T1: title-max-length
[ "${#title}" -gt "$title_max" ] && v "1: T1 title-max-length: ${#title} chars (max ${title_max})"

# T8: title-min-length
[ "${#title}" -lt "$title_min" ] && v "1: T8 title-min-length: ${#title} chars (min ${title_min})"

# T2: title-trailing-whitespace
case "$title" in *[" "$'\t']) v "1: T2 title-trailing-whitespace" ;; esac

# T3: title-trailing-punctuation
case "$title" in *['?:!.,;']) v "1: T3 title-trailing-punctuation" ;; esac

# T4: title-hard-tab
case "$title" in *$'\t'*) v "1: T4 title-hard-tab" ;; esac

# --- Body Rules ---
body_max_line_length=80
body_min=20
require_body=false

# B4: body-first-line-empty
if [ "${#body[@]}" -gt 0 ] && [ -n "${body[0]}" ]; then
    v "2: B4 body-first-line-empty: second line must be blank"
fi

# Per-line body checks (B1/B2/B3)
body_text=""
if [ "${#body[@]}" -gt 0 ]; then
  lineno=1
  for line in "${body[@]}"; do
    lineno=$((lineno + 1))            # body[0] is message line 2

    # B1: body-max-line-length
    [ "${#line}" -gt "$body_max_line_length" ] && v "${lineno}: B1 body-max-line-length: ${#line} chars (max ${body_max_line_length})"

    # B2: body-trailing-whitespace
    case "$line" in *[" "$'\t']) v "${lineno}: B2 body-trailing-whitespace" ;; esac

    # B3: body-hard-tab
    case "$line" in *$'\t'*) v "${lineno}: B3 body-hard-tab" ;; esac

    # Assemble body text for the whole-body rules B5/B6/B8/B7.
    body_text="${body_text}${line}"
  done
fi

body_stripped="$(printf '%s' "$body_text" | tr -d ' \t')"

if [ -z "$body_stripped" ]; then
  # B6: body-is-missing
  if [ "$require_body" = true ]; then
    v "3: B6 body-is-missing: a commit body is required"
  fi
else
  # B5: body-min-length
  [ "${#body_stripped}" -lt "$body_min" ] && v "3: B5 body-min-length: ${#body_stripped} chars (min ${body_min})"
fi

# ======================= REPORT ============================================
if [ "${#violations[@]}" -gt 0 ]; then
  echo "commit-msg: ${#violations[@]} violation(s):" >&2
  printf '  %s\n' "${violations[@]}" >&2
  echo "Run git commit -e -F .git/COMMIT_EDITMSG to retry"
  exit 1
fi
exit 0