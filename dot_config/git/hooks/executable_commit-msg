#!/usr/bin/env bash
set -euo pipefail

# Delegate to a repo-local hook ONLY if it's a different file than this one
# (with core.hooksPath set, git-path hooks == this global dir, so guard against self)
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
repo_hook="$(git rev-parse --git-path hooks)/$(basename "$0")"
repo_hook="$(cd "$(dirname "$repo_hook")" 2>/dev/null && pwd)/$(basename "$repo_hook")"
if [ -x "$repo_hook" ] && [ "$repo_hook" != "$self" ]; then
  "$repo_hook" "$@"
fi

msg_file="$1"   # commit-msg receives the path to the message file

# Comment char is configurable; 'auto' resolves to a real char we can't easily
# predict here, so fall back to '#' (the overwhelmingly common case).
comment_char="$(git config core.commentChar 2>/dev/null || echo '#')"
if [ "$comment_char" = auto ]; then comment_char='#'; fi

# Cut the verbose diff (everything from the scissors line down), drop comment
# lines, then strip leading blanks so "subject" is the first real line —
# mirroring git's default --cleanup=strip. The trailing '|| true' matters:
# grep -v exits 1 when a message is all comments, which set -e would treat as fatal.
cleaned="$(
  sed "\|^${comment_char}.*>8|,\$d" "$msg_file" \
    | grep -v "^${comment_char}" \
    | awk 'NF{f=1} f' \
    || true
)"

subject="$(printf '%s\n' "$cleaned" | head -n1)"
second="$(printf '%s\n' "$cleaned" | sed -n '2p')"

# Skip auto-generated messages: merges, reverts, and autosquash commits have
# intentionally-shaped subjects that these rules would wrongly reject.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

if [ -z "$subject" ]; then
  echo "commit-msg: aborting — empty commit message" >&2
  exit 1
fi

if [ -n "$second" ]; then
  echo "commit-msg: leave a blank line between the subject and body" >&2
  echo "  line 2: ${second}" >&2
  exit 1
fi