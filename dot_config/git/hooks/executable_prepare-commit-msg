#!/usr/bin/env bash
set -euo pipefail

# 1. Delegate to repo-local hook
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
repo_hook="$(git rev-parse --git-path hooks)/$(basename "$0")"
repo_hook="$(cd "$(dirname "$repo_hook")" 2>/dev/null && pwd)/$(basename "$repo_hook")"
if [ -x "$repo_hook" ] && [ "$repo_hook" != "$self" ]; then
  "$repo_hook" "$@"
fi

msg_file="$1"
commit_source="${2:-}"

# Only restore for plain interactive commits: no -m/-F ("message"), no
# --amend/-c/-C ("commit"), no merge/squash in progress. commit-msg writes
# the cache; this only ever reads it.
case "$commit_source" in
  ""|template) ;;
  *) exit 0 ;;
esac

cache_file="$(git rev-parse --git-dir)/PREPARE_COMMIT_MSG_CACHE"
[ -s "$cache_file" ] || exit 0

title="$(sed -n '1p' "$cache_file")"
body="$(sed '1d' "$cache_file" | sed '/^[[:space:]]*$/d')"
[ -n "$title" ] || exit 0

tmp_file=$(mktemp)
{
  echo ""
  echo "# Previous attempt: $title"
  if [ -n "$body" ]; then
    echo "#"
    printf '%s\n' "$body" | sed 's/^/# /'
  fi
  echo "#"
  # Drop the leading blank line(s) git already put in $msg_file so our
  # block flows straight into git's own comment block below it.
  sed -e '/./,$!d' "$msg_file"
} > "$tmp_file"
mv "$tmp_file" "$msg_file"
