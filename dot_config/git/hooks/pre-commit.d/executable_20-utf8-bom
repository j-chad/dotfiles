#!/usr/bin/env bash
# Rejects UTF-8 BOMs in staged blobs.
set -euo pipefail

bom=""
while IFS= read -r -d '' f; do
	if [ "$(git cat-file blob ":$f" 2>/dev/null | head -c3)" = $'\xef\xbb\xbf' ]; then
		bom="${bom}  ${f}"$'\n'
	fi
done < <(git diff --cached -z --name-only --diff-filter=AM)

if [ -n "$bom" ]; then
	printf 'Error: UTF-8 BOM found in:\n%s' "$bom" >&2
	exit 1
fi
