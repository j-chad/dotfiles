{
	"$schema": "https://opencode.ai/config.json",
	"share": "disabled",
	"username": "Jackson",
	"theme": "everforest",
	"default_agent": "plan",
	"autoupdate": "notify",
	"enabled_providers": [
		"github-copilot",
		"anthropic",
		"openai"
	],

	"small_model": "github-copilot/claude-haiku-4.5",
	"model": "github-copilot/claude-sonnet-5",
	"permission": {
		"*": "ask",
		"read": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny",
			"*.env.example": "ask",
			"go vet *": "allow"
		},
		"bash": {
			"*": "ask"
		},
		"task": {
			"*": "ask",
			"explore": "allow"
		},
		"glob": "allow",
		"grep": "allow",
		"list": "allow",
		"todowrite": "allow",
		"todoread": "allow",
		"question": "allow"
  },
	"agent": {
		"plan": {
			"model": "github-copilot/claude-opus-5"
		},
		"explore": {
			"model": "github-copilot/claude-haiku-4.5"
		}
	}
}
