{
	"$schema": "https://opencode.ai/config.json",
	"share": "disabled",
	"update": "disable",
	"snapshots": false,
	"default_agent": "plan",
	"plugins": [
		"@dietrichgebert/ponytail"
	],
	"experimental": {
		"subagent_depth": 1,
		"policies": [
			{ "action": "provider.use", "resource": "*", "effect": "deny" },
			{ "action": "provider.use", "resource": "github-copilot", "effect": "allow" },
			{ "action": "provider.use", "resource": "lmstudio", "effect": "allow" }
		]
	},
	"providers": {
		"lmstudio": {
			"settings": {
				"baseURL": "http://host.docker.internal:1234/v1"
			}
		}
	},
	"model": "github-copilot/gpt-6-luna",
	"agents": {
		"title": {
			"model": "github-copilot/gpt-6-luna"
		},
		"explore": {
			"model": "github-copilot/gpt-6-luna#high"
		}
	},
	"permissions": [
		{ "action": "*", "resource": "*", "effect": "ask" },
		{ "action": "read", "resource": "*", "effect": "allow" },
		{ "action": "read", "resource": "*.env", "effect": "deny" },
		{ "action": "read", "resource": "*.env.*", "effect": "deny" },
		{ "action": "shell", "resource": "*", "effect": "ask" },
		{ "action": "subagent", "resource": "*", "effect": "ask" },
		{ "action": "subagent", "resource": "explore", "effect": "allow" },
		{ "action": "skill", "resource": "*", "effect": "ask" },
		{ "action": "skill", "resource": "ponytail", "effect": "allow" },
		{ "action": "glob", "resource": "*", "effect": "allow" },
		{ "action": "grep", "resource": "*", "effect": "allow" },
		{ "action": "list", "resource": "*", "effect": "allow" },
		{ "action": "todowrite", "resource": "*", "effect": "allow" },
		{ "action": "todoread", "resource": "*", "effect": "allow" },
		{ "action": "question", "resource": "*", "effect": "allow" },
		{ "action": "external_directory", "resource": "*", "effect": "allow" }
	],
	"lsp": true
}
