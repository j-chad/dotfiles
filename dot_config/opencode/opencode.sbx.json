{
	"$schema": "https://opencode.ai/config.json",
	"share": "disabled",
	"autoupdate": false,
	"theme": "everforest",
	"default_agent": "plan",
	"enabled_providers": [
		"github-copilot"
	],
	"small_model": "github-copilot/claude-haiku-4.5",
	"model": "github-copilot/claude-sonnet-5",
	"permission": {
		"*": "ask",
		"read": { "*": "allow", "*.env": "deny", "*.env.*": "deny" },
		"bash": "allow",
		"task": {
			"*": "ask",
			"explore": "allow"
		},
		"glob": "allow",
		"grep": "allow",
		"list": "allow",
		"todowrite": "allow",
		"todoread": "allow",
		"question": "allow"
  },
	"agent": {
		"explore": {
			"model": "github-copilot/claude-haiku-4.5"
		}
	}
}
