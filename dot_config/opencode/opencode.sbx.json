{
	"$schema": "https://opencode.ai/config.json",
	"share": "disabled",
	"autoupdate": false,
	"default_agent": "plan",
	"enabled_providers": [
		"github-copilot"
	],
	"small_model": "github-copilot/gpt-5.6-luna",
	"model": "github-copilot/claude-sonnet-5",
	"subagent_depth": 2,
	"permission": {
		"*": "ask",
		"read": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny"
		},
		"bash": "allow",
		"task": {
			"*": "ask",
			"explore": "allow"
		},
		"glob": "allow",
		"grep": "allow",
		"list": "allow",
		"todowrite": "allow",
		"todoread": "allow",
		"question": "allow",
		"external_directory": "allow"
	},
	"agent": {
		"plan": {
			"model": "github-copilot/claude-opus-5"
		},
		"architect": {
			"model": "github-copilot/claude-opus-5"
		},
		"guide": {
			"model": "github-copilot/claude-opus-5"
		},
		"spec": {
			"model": "github-copilot/claude-sonnet-5"
		},
		"build": {
			"model": "github-copilot/claude-sonnet-5"
		},
		"explore": {
			"model": "github-copilot/gpt-5.6-luna",
			"variant": "xhigh"
		}
	},
	"lsp": true,
	"mcp": {
		"mcp-gateway": {
			"type": "remote",
			"url": "http://mcp-gateway.docker.internal/mcp",
			"enabled": true,
			"headers": { "Authorization": "Bearer proxy-managed" }
		}
	}
}
