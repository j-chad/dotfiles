#!/bin/sh
# Suggests a commit message from the staged diff using a local LM Studio
# server, and adds it as comments (never as editable text) for review.
# Only runs for `git ai-commit` (GIT_COMMIT_AI=1). Best-effort: any failure
# (server down, cold model, malformed output) falls through to a normal
# commit with no suggestion.
set -eu

[ "${GIT_COMMIT_AI:-}" = 1 ] || exit 0
command -v jq >/dev/null 2>&1 || { echo "ai-commit: jq not found; skipping suggestion" >&2; exit 0; }
command -v curl >/dev/null 2>&1 || { echo "ai-commit: curl not found; skipping suggestion" >&2; exit 0; }

msg_file=$1
commit_source=${2:-${PRE_COMMIT_COMMIT_MSG_SOURCE:-}}

case "$commit_source" in
	""|template) ;;
	*) exit 0 ;;
esac

diff=$(git diff --cached)
[ -n "$diff" ] || exit 0

# Cap the total diff size (bytes, not per-line) so large changes don't blow
# the model's context window.
diff=$(printf '%s' "$diff" | head -c 8000)

repo=$(basename "$(git rev-parse --show-toplevel)")
branch=$(git symbolic-ref --short -q HEAD || echo "detached HEAD")
stat=$(git diff --cached --stat | tail -1)
files=$(git diff --cached --name-status)
recent_titles=$(git log -10 --format='- %s' 2>/dev/null || true)

context=$(cat <<EOF
Repository: $repo
Branch: $branch

Recent commit titles (for style reference):
$recent_titles

Staged changes:
$files

Summary: $stat

Staged diff:
$diff
EOF
)

base_url=http://localhost:1234/v1
model=$(git config ai.commitModel || echo "")
timeout=$(git config ai.commitTimeout || echo 20)

schema='{
	"type": "object",
	"properties": {
		"title": {"type": "string", "minLength": 5, "maxLength": 72},
		"body": {"type": "array", "items": {"type": "string", "maxLength": 72}, "maxItems": 10}
	},
	"required": ["title", "body"],
	"additionalProperties": false
}'

system_prompt=$(cat <<'EOF'
You write git commit messages from a diff and repository context. Follow the Go
commit-message style, even if recent titles differ: start the subject with the
primary affected package or component and a colon (for example, 'git: restore
rejected messages'); use comma-separated areas when several are affected. If
there is no obvious package or component, use 'all:' for repository-wide
changes or 'misc:' otherwise. Follow the prefix with a concise, lowercase
imperative summary with no trailing period. Separate the subject from the body
with a blank line. Explain what changed and why in the body, wrapping lines at
about 72 characters. Use 'Fixes #123' or 'Updates #123' only when the issue
number is present in the provided context. Omit the body for trivial changes.
EOF
)

payload=$(jq -n --arg model "$model" --arg context "$context" --arg system_prompt "$system_prompt" --argjson schema "$schema" '
	{
		temperature: 0.2,
		messages: [
			{role: "system", content: $system_prompt},
			{role: "user", content: $context}
		],
		response_format: {type: "json_schema", json_schema: {name: "commit_message", schema: $schema}}
	} + (if $model != "" then {model: $model} else {} end)
')

tmp_out=$(mktemp)
tmp_msg=$(mktemp)
cleanup() { rm -f "$tmp_out" "$tmp_msg"; }
trap cleanup EXIT INT TERM

start=$(date +%s)
curl -s --max-time "$timeout" \
	-H 'Content-Type: application/json' \
	-d "$payload" \
	"$base_url/chat/completions" > "$tmp_out" 2>/dev/null &
curl_pid=$!

if [ -t 2 ]; then
	spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
	i=0
	while kill -0 "$curl_pid" 2>/dev/null; do
		elapsed=$(($(date +%s) - start))
		i=$(((i + 1) % 10))
		frame=$(printf '%s' "$spin" | cut -c$((i + 1)))
		printf '\r%s Generating commit message (LM Studio)… %ss' "$frame" "$elapsed" >&2
		sleep 0.2
	done
	printf '\r\033[K' >&2
else
	echo "ai-commit: generating commit message via LM Studio…" >&2
fi

if ! wait "$curl_pid"; then
	elapsed=$(($(date +%s) - start))
	echo "ai-commit: LM Studio unavailable after ${elapsed}s; continuing without suggestion" >&2
	exit 0
fi
elapsed=$(($(date +%s) - start))

content=$(jq -r '.choices[0].message.content // empty' "$tmp_out" 2>/dev/null || true)
if [ -z "$content" ]; then
	echo "ai-commit: no response from LM Studio after ${elapsed}s; continuing without suggestion" >&2
	exit 0
fi

if ! printf '%s' "$content" \
	| jq -e '(.title | type == "string" and length >= 5 and length <= 72 and (test("[\\r\\n]") | not)) and (.body | type == "array" and length <= 10 and all(.[]; type == "string" and length <= 72 and (test("[\\r\\n]") | not)))' >/dev/null 2>&1; then
	echo "ai-commit: malformed response after ${elapsed}s; continuing without suggestion" >&2
	exit 0
fi

comment_char="$(git config core.commentChar 2>/dev/null || echo '#')"
comment_char_length=$(printf '%s' "$comment_char" | wc -m | tr -d ' ')
if [ "$comment_char" = auto ] || [ "$comment_char_length" -ne 1 ]; then
	echo "ai-commit: unsupported Git comment character; continuing without suggestion" >&2
	exit 0
fi

{
	echo ""
	printf '%s' "$content" | jq -r --arg prefix "$comment_char" '"\($prefix) AI suggestion: \(.title)", (if (.body | length) > 0 then "\($prefix)", (.body[] | "\($prefix) \(.)") else empty end), "\($prefix)", "\($prefix) Remove the comment prefixes above to use this message."'
	cat "$msg_file"
} > "$tmp_msg"
mv "$tmp_msg" "$msg_file"

echo "ai-commit: commit message generated in ${elapsed}s" >&2
