#!/bin/sh
# Adds the cached rejected message as comments for plain interactive commits.
# Message, amend, merge, and squash commits are left unchanged.
set -eu

msg_file=$1
commit_source=${2:-${PRE_COMMIT_COMMIT_MSG_SOURCE:-}}

case "$commit_source" in
	""|template) ;;
	*) exit 0 ;;
esac

cache_file=$(git rev-parse --absolute-git-dir)/PREPARE_COMMIT_MSG_CACHE
[ -s "$cache_file" ] || exit 0

title=$(sed -n '1p' "$cache_file")
[ -n "$title" ] || exit 0

comment_char=$(git config core.commentChar 2>/dev/null || printf '#')
[ "$comment_char" != auto ] || comment_char='#'

tmp_file=$(mktemp)
{
	echo ""
	printf '%s ' "$comment_char"
	printf 'Previous attempt: %s\n' "$title"
	awk -v prefix="$comment_char" 'NR > 1 { if ($0 == "") print prefix; else print prefix " " $0 }' "$cache_file"
	printf '%s\n' "$comment_char"
	sed -e '/./,$!d' "$msg_file"
} > "$tmp_file"
mv "$tmp_file" "$msg_file"
