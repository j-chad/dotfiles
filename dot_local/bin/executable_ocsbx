#!/usr/bin/env zsh
# ocsbx - create or run a sandbox for an OpenCode repository
set -euo pipefail

readonly KIT_REPO="https://gitlab.com/j-chad/sbx.git"
readonly OC_DIR="agents/oc"
readonly ATUIN_DIR="mixins/atuin"
readonly KIT_REF_MARKER="/home/agent/.ocsbx-kit-ref"

log() { print -ru2 -- "[ocsbx] $*"; }

# Resolve to an absolute path so `ocsbx .` doesn't produce the name "oc-."
repo="${${1:-$PWD}:A}"
# sbx names allow only letters, numbers, hyphens, periods and plus/minus
name="oc-${${repo:t}//[^a-zA-Z0-9.+-]/-}"

# Latest tag for a per-component prefix (e.g. "agents/oc"), falling back to
# `main` if there are no tags yet or the remote is unreachable (offline:
# reuse whatever ref the sandbox already has). Tags are per-component
# ("agents/oc/vX.Y.Z"), so filter by prefix before sorting, then re-add it.
latest_kit_ref() {
	local prefix="$1" tags
	local -a tag_list
	tags="$(git ls-remote --tags --refs "$KIT_REPO" 2>/dev/null | sed 's#.*refs/tags/##' | grep "^${prefix}/" | sed "s#^${prefix}/##" | sort -V)" || return 1
	tag_list=(${(f)tags})
	(( $#tag_list )) && print -r -- "${prefix}/${tag_list[-1]}" || print -r -- "main"
}

oc_ref="$(latest_kit_ref "$OC_DIR")" || {
	log "could not reach $KIT_REPO to resolve the latest $OC_DIR ref"
	oc_ref=""
}
atuin_ref="$(latest_kit_ref "$ATUIN_DIR")" || {
	log "could not reach $KIT_REPO to resolve the latest $ATUIN_DIR ref"
	atuin_ref=""
}
oc_kit="git+${KIT_REPO}#ref=${oc_ref:-main}&dir=${OC_DIR}"
atuin_kit="git+${KIT_REPO}#ref=${atuin_ref:-main}&dir=${ATUIN_DIR}"

mounts=()

gomodcache=""
# Share the host Go module cache, but only for repos that actually use Go
if [[ -n "$(find "$repo" -maxdepth 3 -name go.mod -not -path '*/node_modules/*' -print -quit)" ]]; then
	gomodcache="$(go env GOMODCACHE 2>/dev/null || true)"
	[[ -n $gomodcache ]] && mounts+=("$gomodcache:ro")
fi

create_sandbox() {
	log "creating sandbox '$name' for repo '$repo' (oc ref: ${oc_ref:-main}, atuin ref: ${atuin_ref:-main})"
	sbx create --name "$name" \
		--no-share-skills \
		--kit "$oc_kit" \
		--kit "$atuin_kit" \
		oc \
		"$repo" \
		"${mounts[@]}"

	sbx exec -d "$name" bash -c "printf '%s\n%s\n' ${(q)oc_ref:-main} ${(q)atuin_ref:-main} > ${KIT_REF_MARKER}"

	if [[ -n $gomodcache ]]; then
		log "configuring GOPROXY to use the local Go module cache at '$gomodcache'"
		sbx exec -d "$name" bash -c \
			"echo 'export GOPROXY=file://${gomodcache}/cache/download,https://proxy.golang.org,direct' >> /etc/sandbox-persistent.sh"
	fi
}

# Prints "<oc_ref>\n<atuin_ref>" as recorded in the running sandbox.
sandbox_kit_refs() {
	sbx exec -d "$name" bash -c "cat $KIT_REF_MARKER 2>/dev/null" 2>/dev/null
}

sandbox_workspaces() {
	sbx ls --json 2>/dev/null \
		| jq -r --arg n "$name" '.sandboxes[]? | select(.name == $n) | .workspaces[]'
}

if ! sbx ls --json 2>/dev/null | jq -e --arg n "$name" '.sandboxes[]? | select(.name == $n)' >/dev/null; then
	create_sandbox
else
	reasons=()

	current="$(sandbox_kit_refs)"
	current_oc="${${(f)current}[1]}"
	current_atuin="${${(f)current}[2]}"
	[[ -n $current_oc && $current_oc != "${oc_ref:-main}" ]] && reasons+=("oc kit is outdated ($current_oc -> ${oc_ref:-main})")
	[[ -n $current_atuin && $current_atuin != "${atuin_ref:-main}" ]] && reasons+=("atuin kit is outdated ($current_atuin -> ${atuin_ref:-main})")

	want="${(F)${(o)$(print -rl -- "$repo" "${mounts[@]}")}}"
	have="${(F)${(o)$(sandbox_workspaces)}}"
	[[ $want != $have ]] && reasons+=("mounts have changed")

	if (( $#reasons )); then
		log "sandbox '$name' is out of date: ${(j:, :)reasons}"
		if [[ -t 0 ]] && read -q "?[ocsbx] Recreate it? Container-local state will be lost (y/N) "; then
			print
			sbx rm --force "$name"
			create_sandbox
		else
			print
			log "keeping the existing sandbox"
		fi
	fi
fi

sbx run --name "$name"
