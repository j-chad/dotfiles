#!/usr/bin/env zsh
# ocsbx - create or run a sandbox for an OpenCode repository
set -euo pipefail

readonly KIT_REPO="https://gitlab.com/j-chad/sbx.git"
readonly KIT_REF_MARKER="/home/agent/.ocsbx-kit-ref"

# name:dir -- order defines marker file line order.
kits=(
	oc:agents/oc
	atuin:mixins/atuin
	bash-frisk:mixins/bash-frisk
)
kit_names=(${kits%%:*})
kit_dirs=(${kits#*:})

log() { print -ru2 -- "[ocsbx] $*"; }

trap 'log "aborted: command failed at line $LINENO"' ERR

# Resolve to an absolute path so `ocsbx .` doesn't produce the name "oc-."
repo="${${1:-$PWD}:A}"
# sbx names allow only letters, numbers, hyphens, periods and plus/minus
name="oc-${${repo:t}//[^a-zA-Z0-9.+-]/-}"

# Version-sort that works with both GNU sort (`-V`) and the BSD sort shipped
# on macOS, which has no `-V` at all. Prefers a GNU sort if one is on PATH
# (e.g. coreutils' `gsort`), otherwise falls back to a manual numeric-field
# sort good enough for plain `vX.Y.Z` tags.
version_sort() {
	if gsort --version 2>/dev/null | grep -q GNU; then
		gsort -V
	elif sort --version 2>/dev/null | grep -q GNU; then
		sort -V
	else
		awk '{
			orig = $0
			s = $0
			gsub(/^v/, "", s)
			n = split(s, a, ".")
			key = ""
			for (i = 1; i <= 3; i++) key = key sprintf("%010d.", (i <= n ? a[i] + 0 : 0))
			print key, orig
		}' | sort | cut -d' ' -f2-
	fi
}

log "checking for newer kit versions in $KIT_REPO"

# Single unauthenticated fetch of every tag and branch head. Fetched once
# (not once per component) and with the `insteadOf` github/gitlab -> ssh
# rewrite in ~/.gitconfig disabled, so this never triggers an SSH key
# prompt for what is just an anonymous read of a public repo.
#
# Deliberately not `--refs`: that would exclude the `^{}` peeled entries,
# which is exactly what's needed to resolve an annotated tag to the commit
# it points at rather than the tag object.
remote_refs="$(GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_TERMINAL_PROMPT=0 \
	git ls-remote --tags --heads "$KIT_REPO" 2>/dev/null)" || remote_refs=""

# kit_ref[name] = resolved tag/branch name, kit_pin[name] = commit sha it
# points at (or the ref itself if resolution failed).
typeset -A kit_ref kit_pin

if [[ -z $remote_refs ]]; then
	log "could not reach $KIT_REPO; skipping kit-freshness check and reusing whatever the sandbox already has"
else
	typeset -A refmap
	while IFS=$'\t' read -r sha refname; do
		[[ -n $refname ]] && refmap[$refname]="$sha"
	done <<< "$remote_refs"

	# Resolves a tag or branch name to the commit SHA it points at. Remote
	# refs, not local ones, are pinned -- so a moved tag or an advancing
	# `main` is detected as staleness rather than compared as equal forever.
	# Preferring the peeled `^{}` entry is what makes an annotated tag
	# resolve to the commit it points to rather than the tag object itself.
	resolve_ref_sha() {
		local ref="$1"
		# Build the keys in variables first: zsh's brace-matching inside a
		# `${map[...]}` subscript gets confused by a literal `^{}` in the
		# expression itself.
		local peeled_key="refs/tags/${ref}^{}"
		local tag_key="refs/tags/${ref}"
		local head_key="refs/heads/${ref}"
		if [[ -n ${refmap[$peeled_key]:-} ]]; then
			print -r -- "${refmap[$peeled_key]}"
		elif [[ -n ${refmap[$tag_key]:-} ]]; then
			print -r -- "${refmap[$tag_key]}"
		elif [[ -n ${refmap[$head_key]:-} ]]; then
			print -r -- "${refmap[$head_key]}"
		else
			return 1
		fi
	}

	# Latest tag for a per-component prefix (e.g. "agents/oc"). Tags are
	# per-component ("agents/oc/vX.Y.Z"), so filter by prefix before sorting,
	# then re-add it. No tags yet for a component -> fall back to `main`.
	latest_kit_ref() {
		local prefix="$1"
		local -a tag_list
		tag_list=(${(f)"$(print -r -- "$remote_refs" \
			| awk -F'\t' '$2 ~ /^refs\/tags\// && $2 !~ /\^\{\}$/ {print $2}' \
			| sed 's#^refs/tags/##' \
			| grep "^${prefix}/" \
			| sed "s#^${prefix}/##" \
			| version_sort)"})
		(( $#tag_list )) && print -r -- "${prefix}/${tag_list[-1]}" || print -r -- "main"
	}

	for i in {1..$#kit_names}; do
		n="${kit_names[i]}"
		d="${kit_dirs[i]}"
		ref="$(latest_kit_ref "$d")"
		kit_ref[$n]="$ref"
		if sha="$(resolve_ref_sha "$ref")"; then
			kit_pin[$n]="$sha"
		else
			log "could not resolve '$ref' to a commit; falling back to unpinned '$ref'"
			kit_pin[$n]="$ref"
		fi
	done

	log "kit-freshness check: latest refs are ${(j:, :)${(kv)kit_ref}}"
fi

kit_args=()
for i in {1..$#kit_names}; do
	n="${kit_names[i]}"
	kit_args+=(--kit "git+${KIT_REPO}#ref=${kit_pin[$n]:-main}&dir=${kit_dirs[i]}")
done

mounts=()

gomodcache=""
# Share the host Go module cache, but only for repos that actually use Go
if [[ -n "$(find "$repo" -maxdepth 3 -name go.mod -not -path '*/node_modules/*' -print -quit)" ]]; then
	log "detected a go.mod in the repo; sharing the host Go module cache with the sandbox"
	gomodcache="$(go env GOMODCACHE 2>/dev/null || true)"
	if [[ -n $gomodcache ]]; then
		mounts+=("$gomodcache:ro")
	fi
fi

create_sandbox() {
	log "creating sandbox '$name' for repo '$repo' (${(j:, :)${(kv)kit_pin}})"
	sbx create --name "$name" \
		--no-share-skills \
		"${kit_args[@]}" \
		oc \
		"$repo" \
		"${mounts[@]}"

	# Marker records the commit SHA actually pinned (falling back to the
	# human-readable ref if resolution failed), not just the tag name --
	# comparing SHAs is what catches a moved tag or an advanced `main`. One
	# line per kit, in kit_names order.
	marker_lines=()
	for n in $kit_names; do
		marker_lines+=("${(q)${kit_pin[$n]:-main}}")
	done
	sbx exec -d "$name" bash -c "printf '%s\n' ${marker_lines[@]} > ${KIT_REF_MARKER}"

	if [[ -n $gomodcache ]]; then
		log "configuring GOPROXY to use the local Go module cache at '$gomodcache'"
		sbx exec -d "$name" bash -c \
			"echo 'export GOPROXY=file://${gomodcache}/cache/download,https://proxy.golang.org,direct' >> /etc/sandbox-persistent.sh"
	fi
}

# Prints the marker file contents, one ref per line in kit_names order, as
# recorded in the running sandbox. Empty (rather than aborting the script)
# if the sandbox is stopped, unreachable, or predates the marker existing.
sandbox_kit_refs() {
	sbx exec -d "$name" bash -c "cat $KIT_REF_MARKER 2>/dev/null" 2>/dev/null || true
}

# Fetch `sbx ls --json` exactly once, and fail loudly on a real `sbx`
# failure rather than misreading it as "sandbox doesn't exist" (which would
# otherwise walk straight into recreating it).
log "checking for existing sandbox '$name' with sbx ls"
sbx_ls_err="$(mktemp)"
if ! sbx_ls_json="$(sbx ls --json 2>"$sbx_ls_err")"; then
	log "sbx ls failed, cannot continue: $(<$sbx_ls_err)"
	rm -f "$sbx_ls_err"
	exit 1
fi
rm -f "$sbx_ls_err"

log "checking if sandbox '$name' exists and is up to date"
if ! print -r -- "$sbx_ls_json" | jq -e --arg n "$name" '.sandboxes[]? | select(.name == $n)' >/dev/null; then
	create_sandbox
else
	reasons=()

	current=(${(f)"$(sandbox_kit_refs)"})
	if (( ! $#kit_pin )); then
		log "kit refs unresolved (offline earlier); skipping kit-freshness check"
	elif (( $#current != $#kit_names )); then
		# Marker doesn't have exactly one line per currently-installed kit:
		# either it predates a kit being added, predates the marker
		# existing at all, or the write failed after create. Either way the
		# installed kit set doesn't match what we'd create today.
		reasons+=("kit set has changed (marker lists $#current of $#kit_names kits)")
	else
		for i in {1..$#kit_names}; do
			n="${kit_names[i]}"
			have="${current[i]}"
			want="${kit_pin[$n]:-main}"
			[[ $have != "$want" ]] && reasons+=("$n kit is outdated ($have -> $want)")
		done
	fi

	want="${(F)${(o)$(print -rl -- "$repo" "${mounts[@]}")}}"
	have="${(F)${(o)$(print -r -- "$sbx_ls_json" | jq -r --arg n "$name" '.sandboxes[]? | select(.name == $n) | .workspaces[]')}}"
	if [[ $want != $have ]]; then
		reasons+=("mounts have changed")
	fi

	if (( $#reasons )); then
		log "sandbox '$name' is out of date: ${(j:, :)reasons}"
		if [[ -t 0 ]] && read -q "?[ocsbx] Recreate it? Container-local state will be lost (y/N) "; then
			print
			sbx rm --force "$name"
			create_sandbox
		else
			print
			log "keeping the existing sandbox"
		fi
	fi
fi

sbx run --name "$name"
