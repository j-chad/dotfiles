#!/usr/bin/env zsh
# ocsbx - create or run a sandbox for an OpenCode repository
set -euo pipefail

readonly KIT_REPO="https://gitlab.com/j-chad/sbx.git"
readonly KIT_COMMITS_API="https://gitlab.com/api/v4/projects/j-chad%2Fsbx/repository/commits"
readonly KIT_REF_MARKER="/home/agent/.ocsbx-kit-ref"
readonly SBX_LS_TIMEOUT=15

# name:dir -- order defines marker file line order.
kits=(
	oc:agents/oc
	atuin:mixins/atuin
	bash-frisk:mixins/bash-frisk
)
kit_names=(${kits%%:*})
kit_dirs=(${kits#*:})

log() { print -ru2 -- "[ocsbx] $*"; }

trap 'log "aborted: command failed at line $LINENO"' ERR

# Resolve to an absolute path so `ocsbx .` doesn't produce the name "oc-."
repo="${${1:-$PWD}:A}"
# sbx names allow only letters, numbers, hyphens, periods and plus/minus
name="oc-${${repo:t}//[^a-zA-Z0-9.+-]/-}"

log "checking for newer kit versions in $KIT_REPO"

typeset -A kit_pin
for i in {1..$#kit_names}; do
	n="${kit_names[i]}"
	d="${kit_dirs[i]}"
	if sha="$(curl -fsS --get \
		--max-time 15 \
		--data-urlencode "ref_name=main" \
		--data-urlencode "path=$d" \
		--data-urlencode "per_page=1" \
		"$KIT_COMMITS_API" 2>/dev/null | jq -er '.[0].id')"; then
		kit_pin[$n]="$sha"
	else
		kit_pin=()
		log "could not resolve the latest commit for '$d'; skipping kit-freshness check and reusing whatever the sandbox already has"
		break
	fi
done
(( $#kit_pin )) && log "kit-freshness check: latest commits are ${(j:, :)${(kv)kit_pin}}"

kit_args=()
for i in {1..$#kit_names}; do
	n="${kit_names[i]}"
	kit_args+=(--kit "git+${KIT_REPO}#ref=${kit_pin[$n]:-main}&dir=${kit_dirs[i]}")
done

mounts=()

gomodcache=""
# Share the host Go module cache, but only for repos that actually use Go
if [[ -n "$(find "$repo" -maxdepth 3 -name go.mod -not -path '*/node_modules/*' -print -quit)" ]]; then
	log "detected a go.mod in the repo; sharing the host Go module cache with the sandbox"
	gomodcache="$(go env GOMODCACHE 2>/dev/null || true)"
	if [[ -n $gomodcache ]]; then
		mounts+=("$gomodcache:ro")
	fi
fi

create_sandbox() {
	log "creating sandbox '$name' for repo '$repo' (${(j:, :)${(kv)kit_pin}})"
	sbx create --name "$name" \
		--no-share-skills \
		"${kit_args[@]}" \
		oc \
		"$repo" \
		"${mounts[@]}"

	# Marker records the latest commit that touched each kit directory.
	marker_lines=()
	for n in $kit_names; do
		marker_lines+=("${(q)${kit_pin[$n]:-main}}")
	done
	sbx exec -d "$name" bash -c "printf '%s\n' ${marker_lines[@]} > ${KIT_REF_MARKER}"

	if [[ -n $gomodcache ]]; then
		log "configuring GOPROXY to use the local Go module cache at '$gomodcache'"
		sbx exec -d "$name" bash -c \
			"echo 'export GOPROXY=file://${gomodcache}/cache/download,https://proxy.golang.org,direct' >> /etc/sandbox-persistent.sh"
	fi
}

# Prints the marker file contents, one ref per line in kit_names order, as
# recorded in the running sandbox. Empty (rather than aborting the script)
# if the sandbox is stopped, unreachable, or predates the marker existing.
sandbox_kit_refs() {
	sbx exec -d "$name" bash -c "cat $KIT_REF_MARKER 2>/dev/null" 2>/dev/null || true
}

# Kill a stuck sbx client without relying on GNU timeout, which macOS lacks.
run_sbx_ls() {
	local output_file="$1" error_file="$2" timeout_file="$3"
	local command_pid timer_pid exit_status=0

	sbx ls --json >"$output_file" 2>"$error_file" &
	command_pid=$!
	(sleep "$SBX_LS_TIMEOUT"; kill -KILL "$command_pid" && print -r -- timeout >"$timeout_file") >/dev/null 2>&1 &
	timer_pid=$!
	wait "$command_pid" || exit_status=$?
	kill "$timer_pid" >/dev/null 2>&1 || true
	wait "$timer_pid" 2>/dev/null || true
	[[ -e $timeout_file ]] && return 124
	return "$exit_status"
}

# Fetch `sbx ls --json`, retrying only after an accepted daemon restart.
log "checking for existing sandbox '$name' with sbx ls"
sbx_ls_tmp="$(mktemp -d)"
sbx_ls_status=0
run_sbx_ls "$sbx_ls_tmp/output" "$sbx_ls_tmp/error" "$sbx_ls_tmp/timeout" || sbx_ls_status=$?

if (( sbx_ls_status == 124 )); then
	log "sbx ls timed out after ${SBX_LS_TIMEOUT}s"
	if [[ -t 0 ]] && read -q "?[ocsbx] Restart the sbx daemon and retry? (y/N) "; then
		print
		sbx daemon restart
		rm -f "$sbx_ls_tmp/timeout"
		sbx_ls_status=0
		run_sbx_ls "$sbx_ls_tmp/output" "$sbx_ls_tmp/error" "$sbx_ls_tmp/timeout" || sbx_ls_status=$?
	else
		[[ -t 0 ]] && print
	fi
fi

if (( sbx_ls_status != 0 )); then
	if (( sbx_ls_status == 124 )); then
		log "sbx ls timed out, cannot continue"
	else
		log "sbx ls failed, cannot continue: $(<"$sbx_ls_tmp/error")"
	fi
	rm -rf "$sbx_ls_tmp"
	exit 1
fi
sbx_ls_json="$(<"$sbx_ls_tmp/output")"
rm -rf "$sbx_ls_tmp"

log "checking if sandbox '$name' exists and is up to date"
if ! print -r -- "$sbx_ls_json" | jq -e --arg n "$name" '.sandboxes[]? | select(.name == $n)' >/dev/null; then
	create_sandbox
else
	reasons=()

	current=(${(f)"$(sandbox_kit_refs)"})
	if (( ! $#kit_pin )); then
		log "kit commits unresolved (offline earlier); skipping kit-freshness check"
	elif (( $#current != $#kit_names )); then
		# Marker doesn't have exactly one line per currently-installed kit:
		# either it predates a kit being added, predates the marker
		# existing at all, or the write failed after create. Either way the
		# installed kit set doesn't match what we'd create today.
		reasons+=("kit set has changed (marker lists $#current of $#kit_names kits)")
	else
		for i in {1..$#kit_names}; do
			n="${kit_names[i]}"
			have="${current[i]}"
			want="${kit_pin[$n]:-main}"
			[[ $have != "$want" ]] && reasons+=("$n kit is outdated ($have -> $want)")
		done
	fi

	want="${(F)${(o)$(print -rl -- "$repo" "${mounts[@]}")}}"
	have="${(F)${(o)$(print -r -- "$sbx_ls_json" | jq -r --arg n "$name" '.sandboxes[]? | select(.name == $n) | .workspaces[]')}}"
	if [[ $want != $have ]]; then
		reasons+=("mounts have changed")
	fi

	if (( $#reasons )); then
		log "sandbox '$name' is out of date: ${(j:, :)reasons}"
		if [[ -t 0 ]] && read -q "?[ocsbx] Recreate it? Container-local state will be lost (y/N) "; then
			print
			sbx rm --force "$name"
			create_sandbox
		else
			print
			log "keeping the existing sandbox"
		fi
	fi
fi

sbx run --name "$name"
