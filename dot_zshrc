# --- Zinit Install ---
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# --- Starship ---
export STARSHIP_LOG=error
eval "$(starship init zsh)"

# --- Local machine config (PATH, fpath additions, etc.) — BEFORE plugins ---
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# --- Completion system ---
zstyle ':completion:*' menu no                              # fzf-tab captures the menu; do NOT use `menu select`
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"     # colorize (see LS_COLORS note below)
zstyle ':completion:*:descriptions' format '[%d]'           # group headers — required for fzf-tab grouping
zstyle ':completion:*:git-checkout:*' sort false            # keep git's own branch ordering

autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit          # full (security check + rebuild) once per day
else
  compinit -C       # cached, skip checks, every other shell
fi

# --- fzf keybindings + completion — MUST be set up before fzf-tab loads ---
command -v fzf >/dev/null && eval "$(fzf --zsh)"

# fzf-tab previews when completing cd / zoxide
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath 2>/dev/null || ls -1 $realpath'
zstyle ':fzf-tab:complete:z:*'  fzf-preview 'eza -1 --color=always $realpath 2>/dev/null || ls -1 $realpath'
zstyle ':fzf-tab:*' fzf-flags --height=50% --layout=reverse

# --- Async Plugins ---
zinit ice wait lucid
zinit light Aloxaf/fzf-tab

zinit ice wait lucid atload'_zsh_autosuggest_start'
zinit light zsh-users/zsh-autosuggestions

zinit ice wait lucid
zinit light zsh-users/zsh-syntax-highlighting

# --- edit command ---
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# --- History ---
HISTSIZE=2000
SAVEHIST=2000
setopt HIST_IGNORE_ALL_DUPS
setopt SHARE_HISTORY

# --- Lazy NVM ---
export NVM_DIR="$HOME/.nvm"

load-nvm() {
  unset -f node npm npx nvm
  source "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && {
    autoload -Uz bashcompinit && bashcompinit
    source "$NVM_DIR/bash_completion"
  }
}

for cmd in node npm npx nvm; do
  eval "$cmd() { load-nvm; $cmd \"\$@\" }"
done

# --- aliases ---
alias g="git"
compdef g=git
alias ls="eza"

# Git alias completion descriptions, sourced from `git alias` itself.
() {
  local -a cmds=( ${(f)"$(git alias --pairs 2>/dev/null)"} )
  cmds=( ${cmds/$'\t'/:} )                      # name<TAB>desc -> name:desc
  (( $#cmds )) && zstyle ':completion:*:*:git:*' user-commands $cmds
}

# --- zoxide ---
eval "$(zoxide init zsh)"
zoxide add "$PWD" 2>/dev/null   # register the dir this shell started in (IDE terminals, new tabs)
unalias zi 2>/dev/null      # drop zinit's `zi` if it's an alias
zi() { __zoxide_zi "$@" }   # force `zi` to zoxide's interactive query

# --- atuin ---
eval "$(atuin init zsh)"

# --- misc ---
export EDITOR="micro"
export HOMEBREW_AUTO_UPDATE_SECS="86400" # 24 hours

# --- Compile ZSH ---
if [[ ! -f ~/.zshrc.zwc || ~/.zshrc -nt ~/.zshrc.zwc ]]; then
  zcompile ~/.zshrc
fi