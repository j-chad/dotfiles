{{- $plist := printf "%s/Library/LaunchAgents/dev.jacksonc.bash-frisk.plist" .chezmoi.homeDir -}}
#!/bin/sh
# Installs the bash-frisk host binary and (re)loads its service.
# Runs after_ all files/dirs/symlinks, so the plist above is guaranteed to
# already be on disk by the time this executes
set -eu

readonly VERSION="v0.1.1"

if [ "$(id -u)" -eq 0 ]; then
	echo "do not run 'chezmoi apply' with sudo; skipping bash-frisk" >&2
	exit 1
fi

command -v go >/dev/null 2>&1 || { echo "no go, skipping bash-frisk install" >&2; exit 0; }

go install "gitlab.com/j-chad/bash-frisk/cmd/bash-frisk@${VERSION}"
echo "installed bash-frisk@${VERSION}"

{{ if eq .chezmoi.os "darwin" -}}
readonly PLIST="{{ $plist }}"
readonly LABEL="gui/$(id -u)/dev.jacksonc.bash-frisk"

launchctl bootout "$LABEL" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$PLIST"
echo "reloaded bash-frisk LaunchAgent"
{{ else if eq .chezmoi.os "linux" -}}
if command -v systemctl >/dev/null 2>&1; then
	systemctl --user daemon-reload
	systemctl --user enable --now bash-frisk.service
	echo "enabled bash-frisk systemd service"
else
	echo "no systemctl, skipping bash-frisk service" >&2
fi
{{- end }}
